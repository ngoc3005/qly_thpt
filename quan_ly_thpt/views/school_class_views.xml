<odoo>
	<record id="view_school_class_tree" model="ir.ui.view">
		<field name="name">school.class.tree</field>
		<field name="model">school.class</field>
		<field name="arch" type="xml">
			<tree string="Danh sách lớp học">
				<field name="name" />
				<field name="grade" />
				<field name="academic_year" />
				<field name="size" />
				<field name="homeroom_teacher_id" />
			</tree>
		</field>
	</record>
	<record id="view_school_class_form" model="ir.ui.view">
		<field name="name">school.class.form</field>
		<field name="model">school.class</field>
		<field name="arch" type="xml">
			<form string="Chi tiết lớp học">
				<sheet>
					<group>
						<field name="name" />
						<field name="grade" />
						<field name="academic_year" />
						<field name="homeroom_teacher_id" />
					</group>
					<notebook>
						<page string="Danh sách học sinh">
							<field name="student_ids"
								context="{'default_class_id': active_id}">
								<tree editable="bottom">
									<field name="name" />
									<field name="gender" />
									<field name="birth_date" />
									<field name="status" />
								</tree>
							</field>
						</page>
						<page string="Thời khóa biểu">
							<field name="schedule_ids">
								<tree string="Thời khóa biểu">
									<field name="day_of_week" />
									<field name="period" />
									<field name="subject_id" />
									<field name="teacher_id" />
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>
	<record id="action_school_class" model="ir.actions.act_window">
		<field name="name">Lớp học</field>
		<field name="res_model">school.class</field>
		<field name="view_mode">tree,form</field>
	</record>

</odoo>
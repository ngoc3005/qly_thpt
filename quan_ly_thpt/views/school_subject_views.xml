<odoo>
	<!-- Tree view for Subjects -->
	<record id="view_subject_tree" model="ir.ui.view">
		<field name="name">school.subject.tree</field>
		<field name="model">school.subject</field>
		<field name="arch" type="xml">
			<tree string="Subjects" editable="bottom">
				<field name="name" />
				<field name="so_tiet"/>
			</tree>
		</field>
	</record>
	<record id="subject_view_form" model="ir.ui.view">
		<field name="model">school.subject</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<field name="name" />
					<field name="so_tiet"/>
				</group>
			</form>
		</field>
	</record>

	<!-- Action to open tree view -->
	<record id="action_subject" model="ir.actions.act_window">
		<field name="name">Môn học</field>
		<field name="res_model">school.subject</field>
		<field name="view_mode">tree</field>
	</record>

</odoo>

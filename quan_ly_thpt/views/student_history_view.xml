<odoo>
	<!-- Tree View for Student History -->
	<record id="view_student_history_tree" model="ir.ui.view">
		<field name="name">school.student.history.tree</field>
		<field name="model">school.student.history</field>
		<field name="arch" type="xml">
			<tree string="Lịch sử học tập">
				<field name="student_id" />
				<field name="academic_year" />
				<field name="average_semester_1" />
				<field name="average_semester_2" />
				<field name="average_year" />
			</tree>
		</field>
	</record>

	<!-- Form View for Student History -->
	<record id="view_student_history_form" model="ir.ui.view">
		<field name="name">school.student.history.form</field>
		<field name="model">school.student.history</field>
		<field name="arch" type="xml">
			<form string="Lịch sử học tập">
				<sheet>
					<group>
						<field name="student_id" />
						<field name="academic_year" />
					</group>
					<group>
						<field name="average_semester_1" />
						<field name="average_semester_2" />
						<field name="average_year" />
					</group>
					<group string="Học lực và Hạnh kiểm">
						<group>
							<field name="hk_k1" />
							<field name="hk_k2" />
							<field name="hl_cn" />
						</group>
						<group>
							<field name="hl_k1" />
							<field name="hl_k2" />
							<field name="hk_cn" />
						</group>
					</group>
					<group string="Kết loại và Nhận xét">
						<field name="nhan_xet" />
						<field name="ket_luan" />
					</group>
					<notebook>
						<page string="Chi tiết điểm các môn">
							<field name="score_ids">
								<tree editable="bottom" create="0" delete="0">
									<field name="subject_id" />
									<field name="semester_1_score" />
									<field name="semester_2_score" />
									<field name="average_score" />
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<!-- Action to open Student History -->
	<record id="action_student_history"
		model="ir.actions.act_window">
		<field name="name">Lịch sử học tập</field>
		<field name="res_model">school.student.history</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
	</record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<!-- Lịch Thi -->
	<record id="view_tree_thpt_lichthi" model="ir.ui.view">
		<field name="name">thpt.lichthi.tree</field>
		<field name="model">thpt.lichthi</field>
		<field name="arch" type="xml">
			<tree>
				<field name="mon_id" widget="many2many_tags"/>
				<field name="ngay_thi" />
				<field name="gio_bat_dau" />
				<field name="gio_ket_thuc" />
				<field name="ban_thi" />
			</tree>
		</field>
	</record>


	<!-- Form view for Lịch Thi -->
	<record id="view_thpt_lichthi_form" model="ir.ui.view">
		<field name="name">thpt.lichthi.form</field>
		<field name="model">thpt.lichthi</field>
		<field name="arch" type="xml">
			<form string="Lịch thi THPT">
				<header>
					<button name="action_tao_phong_thi" string="Tạo phòng thi"
						type="object" class="btn-primary" />
				</header>
				<sheet>
					<group>
						<field name="mon_id" widget="many2many_tags"/>
						<field name="grade" />
						<field name="ngay_thi" />
						<field name="gio_bat_dau" />
						<field name="gio_ket_thuc" />
						<field name="ban_thi" />
					</group>
					<group>
						<field name="giam_thi_ids" widget="many2many_tags" />
					</group>
					<notebook>
						<page string="Phòng Thi">
							<field name="phong_thi_ids">
								<tree string="Danh sách phòng thi">
									<field name="name" />
									<field name="hoc_sinh_ids" widget="many2many_tags" />
								</tree>
								<form string="Chi tiết phòng thi">
									<sheet>
										<field name="name" />
										<field name="hoc_sinh_ids" widget="many2many_tags" />
									</sheet>
								</form>
							</field>
						</page>
					</notebook>
				</sheet>
				<footer>
					<button name="action_tao_phong_thi" string="Tạo phòng thi"
						type="object" class="btn-primary" />
					<button string="Đóng" class="btn-secondary" special="cancel" />
				</footer>
			</form>
		</field>
	</record>

	<!-- Kết Quả Thi -->
	<record id="view_tree_thpt_ketqua" model="ir.ui.view">
		<field name="name">thpt.ketqua.tree</field>
		<field name="model">thpt.ketqua</field>
		<field name="arch" type="xml">
			<tree>
				<field name="hoc_sinh_id" />
				<field name="lich_thi_id" />
				<field name="diem_so" />
				<field name="ket_qua" />
			</tree>
		</field>
	</record>

	<record id="view_form_thpt_ketqua" model="ir.ui.view">
		<field name="name">thpt.ketqua.form</field>
		<field name="model">thpt.ketqua</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="hoc_sinh_id" />
						<field name="lich_thi_id" />
						<field name="diem_so" />
						<field name="ket_qua" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<!-- Phòng Thi -->
	<record id="view_tree_thpt_phongthi" model="ir.ui.view">
		<field name="name">thpt.phongthi.tree</field>
		<field name="model">thpt.phongthi</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name" />
				<field name="lich_thi_id" />
			</tree>
		</field>
	</record>

	<record id="view_form_thpt_phongthi" model="ir.ui.view">
		<field name="name">thpt.phongthi.form</field>
		<field name="model">thpt.phongthi</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name" />
						<field name="lich_thi_id" />
						<field name="hoc_sinh_ids" widget="many2many_tags" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_thpt_lichthi" model="ir.actions.act_window">
		<field name="name">Lịch Thi</field>
		<field name="res_model">thpt.lichthi</field>
		<field name="view_mode">tree,form</field>
	</record>

	<record id="action_thpt_ketqua" model="ir.actions.act_window">
		<field name="name">Kết Quả Thi</field>
		<field name="res_model">thpt.ketqua</field>
		<field name="view_mode">tree,form</field>
	</record>

	<record id="action_thpt_phongthi" model="ir.actions.act_window">
		<field name="name">Phòng Thi</field>
		<field name="res_model">thpt.phongthi</field>
		<field name="view_mode">tree,form</field>
	</record>

	<menuitem id="menu_thpt_lichthi" name="Lịch Thi" action="action_thpt_lichthi" 
		parent="menu_school_root" sequence="10" />

	<!-- <menuitem id="menu_thpt_lichthi_main" name="Lịch Thi"
		parent="menu_thpt_lichthi" action="action_thpt_lichthi" sequence="1" /> -->

	<!-- <menuitem id="menu_thpt_ketqua" name="Kết Quả Thi"
		parent="menu_thpt_lichthi" action="action_thpt_ketqua" sequence="2" />

	<menuitem id="menu_thpt_phongthi" name="Phòng Thi"
		parent="menu_thpt_lichthi" action="action_thpt_phongthi" sequence="3" /> -->


</odoo>
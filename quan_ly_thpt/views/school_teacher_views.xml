<odoo>
    <record id="view_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="teacher_code"/>
                        <field name="age"/>
                        <field name="gender"/>
                        <field name="phone" widget="phone"/>
                        <field name="email" widget="email"/>
                        <field name="address"/>
                    </group>
                    <group string="Thông tin giảng dạy">
                        <field name="subject_ids" widget="many2many_tags"/>
                       <!--  <field name="homeroom_teacher_id"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree string="Teachers">
                <field name="name"/>
                <field name="teacher_code"/>
                <field name="subject_ids" widget="many2many_tags"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Giáo viên</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>

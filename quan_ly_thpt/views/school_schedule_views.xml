<odoo>
	<record id="view_schedule_tree" model="ir.ui.view">
		<field name="name">school.schedule.tree</field>
		<field name="model">school.schedule</field>
		<field name="arch" type="xml">
			<tree string="Thời khóa biểu">
				<field name="class_id" />
				<field name="subject_id" />
				<field name="teacher_id" />
				<field name="day_of_week" />
				<field name="period" />
			</tree>
		</field>
	</record>
	<record id="action_generate_schedule_server"
		model="ir.actions.server">
		<field name="name">Generate Schedule</field>
		<field name="model_id" ref="model_school_auto_scheduler" />
		<field name="state">code</field>
		<field name="code">model.generate_schedule()</field>
	</record>

	<record id="view_schedule_form" model="ir.ui.view">
		<field name="name">school.schedule.form</field>
		<field name="model">school.schedule</field>
		<field name="arch" type="xml">
			<form string="Thời khóa biểu">
				<sheet>
					<header>
						<button name="%(action_generate_schedule_server)d"
							string="Tạo thời khóa biểu" type="action" class="btn-primary" />
					</header>
					<group>
						<field name="class_id" />
						<field name="subject_id" />
						<field name="teacher_id" />
						<field name="day_of_week" />
						<field name="period" />
					</group>
				</sheet>
			</form>
		</field>
	</record>
	<record id="action_schedule" model="ir.actions.act_window">
		<field name="name">Thời khóa biểu</field>
		<field name="res_model">school.schedule</field>
		<field name="view_mode">tree,form</field>
	</record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="module_quan_ly_thpt"
		model="ir.module.category">
		<field name="name">Quản lý trường học</field>
		<field name="sequence">1</field>
	</record>

	<record id="group_hr_user" model="res.groups">
		<field name="name">Giáo viên</field>
		<field name="category_id" ref="module_quan_ly_thpt" />
		<field name="users"
			eval="[(4, ref('base.user_root'))]" />
		<field name="comment">The user will be able.</field>
	</record>

	<record id="group_hr_manager" model="res.groups">
		<field name="name">Quản trị viên</field>
		<field name="comment">Admin</field>
		<field name="category_id" ref="module_quan_ly_thpt" />
		<field name="implied_ids"
			eval="[(4, ref('group_hr_user'))]" />
		<field name="users"
			eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
	</record>

</odoo>

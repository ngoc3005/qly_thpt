<odoo>
    <record id="view_auto_scheduler_wizard" model="ir.ui.view">
        <field name="name">school.auto_scheduler.wizard.form</field>
        <field name="model">school.auto_scheduler.wizard</field>
        <field name="arch" type="xml">
            <form string="Tự động phân thời khóa biểu">
                <footer>
                    <button name="action_generate_schedule" string="Tạo thời khóa biểu" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_auto_scheduler_wizard" model="ir.actions.act_window">
        <field name="name">Tự động phân lịch</field>
        <field name="res_model">school.auto_scheduler.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

  
</odoo>
